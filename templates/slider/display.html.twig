{% extends 'base.html.twig' %}

{% block title %}PIN eingeben{% endblock %}

{# TV pages: ES5-only tv.js, no Turbo/importmap, no management.css (avoids
   modern selectors such as :has() that some TV engines reject). #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/basics.css') }}">
    <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components.css') }}">
    <link rel="stylesheet" href="{{ asset('css/slider.css') }}">
{% endblock %}
{% block app_javascripts %}
    <script src="{{ asset('js/tv.js') }}" defer></script>
{% endblock %}
{% block importmap %}{% endblock %}

{% block body %}
    <div class="container">
        <div class="surface" style="text-align: center;">
            <h1>Slider mit einer Kita verbinden</h1>

            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}

            <p>
                Geben Sie die 4-stellige PIN ein, die in den Einstellungen der
                gewünschten Kita hinterlegt wurde. Dieses Gerät merkt sich die
                Verbindung und startet den Slider künftig automatisch.
            </p>

            <form method="post" class="pin-form">
                <label for="display-pin" class="sr-only">PIN</label>
                <input type="text" name="pin" id="display-pin" class="pin-input"
                       inputmode="numeric" pattern="\d{4}" maxlength="4"
                       placeholder="0000" autocomplete="off" required autofocus
                       data-pin-autosubmit>

                <input type="hidden" name="_token" value="{{ csrf_token('display-pin') }}">

                {# No visible CTA: the device's own confirm key (OK/Enter) submits
                   the form; entering the 4th digit submits automatically. #}
                <button class="sr-only" type="submit">Slider starten</button>

                <p style="color: #6b7280;">
                    Die Verbindung startet automatisch nach der 4. Ziffer –
                    alternativ mit der OK-/Enter-Taste bestätigen.
                </p>
            </form>
        </div>
    </div>
{% endblock %}
