{# With lazy_images only the first slide carries its image address in "src";
   the others keep it in "data-src" until tv.js loads them shortly before
   their turn. A slider with hundreds of photos must not load them all at once.
   TVs still running an older tv.js poll without that flag and get "src" everywhere. #}
{% for item in items %}
    {% set content = item.content %}
    {% set image_attribute = lazy_images and not loop.first ? 'data-src' : 'src' %}
    {% if content.type.value == 'image' %}
        <div class="tv-slide tv-slide-image {% if loop.first %}is-active{% endif %}"
             data-slide-key="{{ content.id }}-{{ content.lastUpdatedAt.timestamp }}">
            <img {{ image_attribute }}="{{ asset(content.imageUrl) }}" alt="Slider Image">
        </div>
    {% elseif content.type.value == 'article' %}
        <div class="tv-slide tv-slide-article {% if loop.first %}is-active{% endif %}"
             data-slide-key="{{ content.id }}-{{ content.lastUpdatedAt.timestamp }}">
            <div class="tv-article-media">
                {% if content.imageUrl %}
                    <img {{ image_attribute }}="{{ asset(content.imageUrl) }}" alt="Article Image">
                {% endif %}
            </div>
            <div class="tv-article-content">
                <div class="tv-article-title">{{ content.title }}</div>
                <div class="tv-article-body">
                    {{ content.content|default('')|sanitize_html('article_body') }}
                </div>
            </div>
        </div>
    {% endif %}
{% else %}
    <div class="tv-empty-state">
        Keine aktiven Inhalte verfügbar.
    </div>
{% endfor %}
