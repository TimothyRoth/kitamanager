{% extends 'base.html.twig' %}

{% block title %}Slider{% endblock %}

{# TV pages: ES5-only tv.js, no Turbo/importmap, lean CSS for old engines. #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/basics.css') }}">
    <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components.css') }}">
    <link rel="stylesheet" href="{{ asset('css/slider.css') }}">
{% endblock %}
{% block app_javascripts %}
    <script src="{{ asset('js/tv.js') }}" defer></script>
{% endblock %}
{% block importmap %}{% endblock %}

{% block body %}
    <div class="tv-slider-viewport"
         data-duration="{{ user.durationBetweenSlides * 1000 }}"
         data-refresh-url="{{ path('app_slider_content', {'slug': user.slug}) }}"
         data-refresh-interval="30000"
         data-content-signature="{{ signature }}"
         data-display-url="{{ path('app_slider_display') }}"
         id="tv-slider">
        {{ slides|raw }}
    </div>
{% endblock %}
