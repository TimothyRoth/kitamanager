{% extends 'base.html.twig' %}

{% block title %}Slider{% endblock %}

{% block body %}
    <div class="tv-slider-viewport"
         data-duration="{{ user.durationBetweenSlides * 1000 }}"
         data-refresh-url="{{ path('app_slider_content', {'slug': user.slug}) }}"
         data-refresh-interval="30000"
         data-content-signature="{{ signature }}"
         id="tv-slider">
        {{ slides|raw }}
    </div>
{% endblock %}
