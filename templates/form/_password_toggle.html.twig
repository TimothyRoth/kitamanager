{# Hidden until password-toggle.js enables it, so no dead button without JavaScript. #}
{% import '_icons.html.twig' as icons %}
<button type="button" class="password-toggle" data-password-toggle hidden
        aria-label="Passwort anzeigen" aria-pressed="false" title="Passwort anzeigen">
    <span class="password-toggle-show">{{ icons.icon('eye') }}</span>
    <span class="password-toggle-hide">{{ icons.icon('eye-off') }}</span>
</button>
