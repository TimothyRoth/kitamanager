{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Admin Dashboard{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    {{ include('management/_header.html.twig', {settings_anchor: true}) }}

    <main class="page">
        {{ include('management/_flashes.html.twig') }}

        <section class="hero">
            <h1>Willkommen, {{ app.user.username }}!</h1>
            <nav class="quick-actions" aria-label="Schnellaktionen">
                <a href="{{ path('app_management_create_image') }}" class="quick-action quick-action-primary">
                    {{ icons.icon('camera') }}
                    <span><strong>Bilder hinzufügen</strong><small>Für alle oder ausgewählte Kitas</small></span>
                </a>
                <a href="{{ path('app_management_create_article') }}" class="quick-action">
                    {{ icons.icon('document') }}
                    <span><strong>Artikel schreiben</strong><small>Text mit Bild</small></span>
                </a>
            </nav>
        </section>

        <div class="dashboard dashboard-even">
            <section class="panel" id="kitas">
                <header class="panel-header">
                    <span class="panel-icon">{{ icons.icon('users') }}</span>
                    <div class="panel-heading">
                        <h2>Kitas</h2>
                        <p>Konten, Fernseher-PINs und wer an wen ausspielen darf.</p>
                    </div>
                    <span class="count-chip">{{ users|length }}</span>
                </header>

                <details class="disclosure"{{ form.vars.submitted and not form.vars.valid ? ' open' }}>
                    <summary>{{ icons.icon('plus') }} Neuen Benutzer anlegen</summary>
                    <div class="disclosure-body">
                        {{ form_start(form) }}
                        {{ form_row(form.username, {'label': 'Benutzername'}) }}
                        {{ form_row(form.plainPassword, {'label': 'Passwort'}) }}
                        {{ form_row(form.publishToAll) }}
                        <div data-publish-targets>
                            {{ form_row(form.publishTargets) }}
                        </div>
                        <button type="submit" class="btn btn-primary">Benutzer hinzufügen</button>
                        {{ form_end(form) }}
                    </div>
                </details>

                {% if users is empty %}
                    <p class="empty-state">Keine Benutzer gefunden.</p>
                {% else %}
                    {% if users|length > 8 %}
                        <div class="list-filter">
                            <input type="search" placeholder="Kita suchen …" aria-label="Kita suchen" autocomplete="off"
                                   data-list-filter="#kita-list">
                            <span class="list-filter-count" data-list-filter-count></span>
                        </div>
                    {% endif %}
                    <ul class="user-list" id="kita-list">
                        {% for user in users %}
                            <li class="user-row" data-filter-text="{{ user.username }}">
                                <div class="user-row-text">
                                    <span class="user-row-name">{{ user.username }}</span>
                                    {% if user.devicePin %}
                                        <span class="pin-chip" title="Slider über diese PIN erreichbar">
                                            {{ icons.icon('tv') }} PIN <span class="pin-reachability-code">{{ user.devicePin }}</span>
                                        </span>
                                    {% else %}
                                        <span class="pin-chip pin-chip-missing">{{ icons.icon('tv') }} nicht erreichbar</span>
                                    {% endif %}
                                </div>
                                <div class="user-row-actions">
                                    <a href="{{ path('app_slider', {'slug': user.slug}) }}" class="btn btn-ghost btn-square"
                                       aria-label="Slider von {{ user.username }} ansehen" title="Slider ansehen">{{ icons.icon('eye') }}</a>
                                    <a href="{{ path('app_management_edit_user', {'id': user.id}) }}" class="btn btn-secondary">{{ icons.icon('pencil') }}<span class="btn-text-optional">Bearbeiten</span></a>
                                    <form method="post" action="{{ path('app_management_delete_user', {'id': user.id}) }}"
                                          data-confirm="Soll dieser Benutzer mitsamt all seiner Beiträge endgültig gelöscht werden?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button type="submit" class="btn btn-danger-quiet" aria-label="{{ user.username }} löschen" title="Löschen">{{ icons.icon('trash') }}</button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section class="panel" id="zentrale-inhalte">
                <header class="panel-header">
                    <span class="panel-icon">{{ icons.icon('images') }}</span>
                    <div class="panel-heading">
                        <h2>Zentrale Inhalte</h2>
                        <p>Von Ihnen erstellt und an Kitas ausgespielt. Die Zielgruppe legen Sie beim Bearbeiten fest.</p>
                    </div>
                    <span class="count-chip">{{ contents|length }}</span>
                </header>

                {{ include('management/_contents.html.twig', {
                    redirect_route: 'app_management_admin',
                    empty_text: 'Keine zentralen Inhalte gefunden.',
                    creator_has_slider: false
                }) }}
            </section>
        </div>

        <section class="panel" id="einstellungen">
            <header class="panel-header">
                <span class="panel-icon">{{ icons.icon('settings') }}</span>
                <div class="panel-heading">
                    <h2>Einstellungen</h2>
                    <p>Ihr Passwort.</p>
                </div>
            </header>
            <div class="settings-grid">
                {{ include('management/_password_form.html.twig') }}
            </div>
        </section>
    </main>
{% endblock %}
