{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Benutzer-Dashboard{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    {{ include('management/_header.html.twig', {settings_anchor: true}) }}

    <main class="page">
        {{ include('management/_flashes.html.twig') }}

        <section class="hero">
            <h1>Willkommen, {{ app.user.username }}!</h1>
            <nav class="quick-actions" aria-label="Schnellaktionen">
                <a href="{{ path('app_management_create_image') }}" class="quick-action quick-action-primary">
                    {{ icons.icon('camera') }}
                    <span><strong>Fotos hinzufügen</strong><small>Aufnehmen oder auswählen</small></span>
                </a>
                <a href="{{ path('app_management_create_article') }}" class="quick-action">
                    {{ icons.icon('document') }}
                    <span><strong>Artikel schreiben</strong><small>Text mit Bild</small></span>
                </a>
                <a href="{{ path('app_slider') }}" class="quick-action">
                    {{ icons.icon('eye') }}
                    <span><strong>Vorschau</strong><small>So sieht es der Fernseher</small></span>
                </a>
            </nav>
        </section>

        <div class="dashboard dashboard-slider">
            <section class="panel" id="mein-slider">
                <header class="panel-header">
                    <span class="panel-icon">{{ icons.icon('tv') }}</span>
                    <div class="panel-heading">
                        <h2>Mein Slider</h2>
                        <p>Das zeigt Ihr Fernseher – in dieser Reihenfolge.</p>
                    </div>
                    <span class="count-chip">{{ sliderItems|length }}</span>
                </header>

                {% if sliderItems is empty %}
                    <p class="empty-state">Ihr Slider enthält noch keine Inhalte.</p>
                {% else %}
                    <ol class="slide-list" data-sortable-list
                        data-reorder-url="{{ path('app_management_slider_reorder') }}"
                        data-reorder-token="{{ csrf_token('reorder-slider') }}">
                        {% for item in sliderItems %}
                            {% set content = item.content %}
                            {% set isOwnContent = content.creator and content.creator.id == app.user.id %}
                            {% set isArticle = content.type.value == 'article' %}
                            <li class="slide-row{{ isOwnContent and not item.isEnabled ? ' is-disabled' }}"
                                id="slider-item-{{ item.id }}" data-item-id="{{ item.id }}">
                                <button type="button" class="drag-handle" data-drag-handle
                                        aria-label="Reihenfolge ändern: ziehen oder Pfeiltasten hoch/runter"
                                        title="Ziehen, um die Reihenfolge zu ändern"{{ sliderItems|length < 2 ? ' disabled' }}>
                                    {{ icons.icon('grip') }}
                                </button>
                                <div class="slide-thumb">
                                    {% if content.imageUrl %}
                                        <img src="{{ asset(content.imageUrl) }}" alt="" loading="lazy">
                                    {% endif %}
                                    <span class="slide-position" data-slide-position>{{ loop.index }}</span>
                                </div>
                                <div class="slide-text">
                                    <span class="slide-title"{% if isArticle %} title="{{ content.title }}"{% endif %}>{{ isArticle ? content.title : 'Bild' }}</span>
                                    <span class="slide-source">
                                        {%- if isArticle %}Artikel · {% endif -%}
                                        {%- if isOwnContent -%}
                                            Eigener Inhalt
                                        {%- else -%}
                                            von {{ content.creator ? content.creator.username : 'unbekannt' }}
                                        {%- endif -%}
                                    </span>
                                </div>
                                {% if isOwnContent %}
                                    <form method="post" class="slide-status"
                                          action="{{ path('app_management_slider_toggle_status', {'id': item.id}) }}"
                                          data-preserve-scroll>
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ item.id) }}">
                                        <button type="submit" class="switch{{ item.isEnabled ? ' is-on' }}" role="switch"
                                                aria-checked="{{ item.isEnabled ? 'true' : 'false' }}"
                                                aria-label="Auf dem Fernseher anzeigen"
                                                title="{{ item.isEnabled ? 'Aktiv – tippen zum Ausblenden' : 'Ausgeblendet – tippen zum Anzeigen' }}">
                                            <span class="switch-track"><span class="switch-thumb"></span></span>
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="slide-status slide-locked" title="Zugewiesene Inhalte können nicht deaktiviert werden">
                                        {{ icons.icon('lock') }}<span class="sr-only">Zugewiesen – nicht änderbar</span>
                                    </span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                    <p class="panel-footnote">
                        {{ icons.icon('grip') }} ziehen zum Sortieren ·
                        Schalter blendet eigene Inhalte aus ·
                        {{ icons.icon('lock') }} von anderen zugewiesen
                    </p>
                {% endif %}
            </section>

            <section class="panel" id="meine-inhalte">
                <header class="panel-header">
                    <span class="panel-icon">{{ icons.icon('images') }}</span>
                    <div class="panel-heading">
                        <h2>Meine Inhalte</h2>
                        <p>Von Ihnen erstellt – hier bearbeiten, löschen und sehen, wer es bekommt.</p>
                    </div>
                    <span class="count-chip">{{ contents|length }}</span>
                </header>

                {{ include('management/_contents.html.twig', {
                    empty_text: 'Sie haben noch keine Inhalte erstellt.',
                    creator_has_slider: true
                }) }}
            </section>
        </div>

        <section class="panel" id="einstellungen">
            <header class="panel-header">
                <span class="panel-icon">{{ icons.icon('settings') }}</span>
                <div class="panel-heading">
                    <h2>Einstellungen</h2>
                    <p>Anzeigedauer und Passwort.</p>
                </div>
            </header>
            <div class="settings-grid">
                <div class="settings-block">
                    <h3>Anzeigedauer</h3>
                    {{ form_start(durationForm, {'attr': {'data-preserve-scroll': ''}}) }}
                    {{ form_row(durationForm.durationBetweenSlides) }}
                    <button type="submit" class="btn btn-primary">Dauer speichern</button>
                    {{ form_end(durationForm) }}
                </div>
                {{ include('management/_password_form.html.twig') }}
            </div>
        </section>
    </main>
{% endblock %}
