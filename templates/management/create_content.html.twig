{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="surface">
            <h1>{{ page_title }}</h1>

            {# The bulk image form uploads via a sequential AJAX loop (one
               request per image); the endpoint data is ignored by the
               single-image forms, which keep the plain whole-form XHR. #}
            {{ form_start(form, {'attr': {
                'data-upload-with-progress': '',
                'data-turbo': 'false',
                'data-upload-endpoint': path('app_management_upload_image'),
                'data-upload-token': csrf_token('upload-image'),
                'data-upload-success-url': path('app_management_user')
            }}) }}
            <div class="form-group">
                {{ form_widget(form) }}
            </div>
            <button type="submit" class="btn btn-primary">Speichern</button>
            {{ form_end(form) }}

            <div style="margin-top: var(--spacing-md);">
                <a href="{{ path(app.user ? 'app_management_user' : 'app_management_admin') }}" class="btn btn-link">Zurück
                    zum Dashboard</a>
            </div>
        </div>
    </div>
{% endblock %}
