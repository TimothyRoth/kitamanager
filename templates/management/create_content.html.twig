{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ page_title }}{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    {{ include('management/_header.html.twig') }}

    <main class="page page-narrow">
        <a href="{{ path('app_management_user') }}" class="back-link">{{ icons.icon('back') }} Zurück zum Dashboard</a>
        {{ include('management/_flashes.html.twig') }}

        <section class="panel">
            <h1>{{ page_title }}</h1>

            {# The bulk image form uploads via a sequential AJAX loop (one
               request per image); the endpoint data is ignored by the
               single-image forms, which keep the plain whole-form XHR. #}
            {{ form_start(form, {'attr': {
                'data-upload-with-progress': '',
                'data-upload-endpoint': path('app_management_upload_image'),
                'data-upload-token': csrf_token('upload-image'),
                'data-upload-success-url': path('app_management_user') ~ '#mein-slider'
            }}) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary btn-large">
                {{ submit_label }}
            </button>
            {{ form_end(form) }}
        </section>
    </main>
{% endblock %}
