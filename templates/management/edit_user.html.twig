{% extends 'base.html.twig' %}

{% block title %}Bearbeiten{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="surface">
            <h1>In Bearbeitung: {{ user.username }}</h1>

            {{ form_start(form) }}
            <div class="form-group">
                {{ form_row(form.username) }}
            </div>
            <div class="form-group">
                {{ form_row(form.plainPassword, {'required': false, 'label': 'Neues Passwort (nur nötig bei Änderung)'}) }}
            </div>
            <div class="form-group">
                {{ form_row(form.publishToAll) }}
            </div>
            <div class="form-group" data-publish-targets>
                {{ form_row(form.publishTargets) }}
            </div>
            <button type="submit" class="btn btn-primary">Änderungen speichern</button>
            {{ form_end(form) }}
        </div>

        <div class="surface" style="margin-top: var(--spacing-xl);">
            <h2>Fernseher zuordnen</h2>
            <p>
                Legen Sie hier eine 4-stellige PIN für diesen Benutzer fest. Die PIN wird
                einmalig auf dem Fernseher unter
                <a href="{{ path('app_slider_display') }}"><code>{{ path('app_slider_display') }}</code></a>
                eingegeben –
                der Fernseher merkt sich die Verbindung und zeigt dann automatisch den
                Slider dieses Benutzers an. Mehrere Fernseher können dieselbe PIN verwenden.
            </p>

            {% if user.devicePin %}
                <div class="alert alert-success pin-reachability" role="status">
                    Der Slider von <strong>{{ user.username }}</strong> ist derzeit über die
                    PIN <strong class="pin-reachability-code">{{ user.devicePin }}</strong> erreichbar
                    (<a href="{{ path('app_slider', {'slug': user.slug}) }}">Vorschau öffnen</a>).
                </div>
            {% else %}
                <div class="alert alert-warning pin-reachability" role="status">
                    Derzeit ist keine PIN hinterlegt – der Slider von
                    <strong>{{ user.username }}</strong> ist nicht über die Fernseher-Zuordnung erreichbar.
                </div>
            {% endif %}

            {{ form_start(devicePinForm, {'attr': {'data-turbo-scroll': 'false'}}) }}
            <div class="form-group">
                {{ form_row(devicePinForm.devicePin) }}
            </div>
            <button type="submit" class="btn btn-primary">PIN speichern</button>
            {{ form_end(devicePinForm) }}
        </div>

        <div class="surface" style="margin-top: var(--spacing-md);">
            <a href="{{ path('app_management_admin') }}" class="btn btn-link">Zurück zum Dashboard</a>
        </div>
    </div>
{% endblock %}
