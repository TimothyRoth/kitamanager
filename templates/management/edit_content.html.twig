{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ page_title }}{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    {{ include('management/_header.html.twig') }}

    <main class="page page-narrow">
        <a href="{{ path('app_management_user') }}" class="back-link">{{ icons.icon('back') }} Zurück zum Dashboard</a>
        {{ include('management/_flashes.html.twig') }}

        <section class="panel">
            <h1>{{ page_title }}</h1>

            {% if content.imageUrl %}
                <figure class="current-image">
                    <img src="{{ asset(content.imageUrl) }}" alt="{{ content.title }}">
                    <figcaption>Aktuelles Bild</figcaption>
                </figure>
            {% endif %}

            {{ form_start(form, {'attr': {'data-upload-with-progress': ''}}) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary btn-large">Änderungen speichern</button>
            {{ form_end(form) }}
        </section>
    </main>
{% endblock %}
