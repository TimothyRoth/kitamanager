{# The shapes live in _icon_sprite.html.twig, which every page that uses icons includes once. #}
{% macro icon(name) -%}
    <svg class="icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-{{ name }}"/></svg>
{%- endmacro %}
