{% extends 'base.html.twig' %}

{% block title %}Anmelden{% endblock %}
{% block body_class %}management{% endblock %}

{% block body %}
    <div class="container">
        <div class="surface login-surface">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-success">
                        Sie sind angemeldet als {{ app.user.userIdentifier }}, <a
                            href="{{ logout_path() }}" class="btn-link">Abmelden</a>
                    </div>
                {% else %}

                    <h1>Bitte melden Sie sich an</h1>

                    <div class="form-group">
                        <label for="username">Benutzername</label>
                        <input type="text" value="{{ last_username }}" name="_username" id="username"
                               autocomplete="username" required autofocus enterkeyhint="next"
                               autocapitalize="none" autocorrect="off" spellcheck="false">
                    </div>

                    <div class="form-group">
                        <label for="password">Passwort</label>
                        <input type="password" name="_password" id="password" autocomplete="current-password"
                               required enterkeyhint="go">
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                           value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-primary btn-block" type="submit">
                        Anmelden
                    </button>

                {% endif %}
            </form>
        </div>
    </div>
{% endblock %}
