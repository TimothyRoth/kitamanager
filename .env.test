# committed test defaults – never point at a shared/prod database
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Doctrine ignores this in test (see config/packages/doctrine.yaml when@test),
# but keep an explicit safe value for anything that still reads DATABASE_URL.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
MESSENGER_TRANSPORT_DSN=in-memory://
MAILER_DSN=null://null
